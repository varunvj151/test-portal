# ============================================================
# PRODUCTION ENVIRONMENT (Supabase + Vercel + External Judge)
# ============================================================

# Supabase PostgreSQL Connection String
# Direct connection (port 5432) or Transaction Pooler (port 6543)
# Note: If password contains special characters like '@', connection.ts safely handles it.
DATABASE_URL=postgresql://postgres:Admin123%40hitech@db.cyrcwbmrvzsqscrqhrvo.supabase.co:5432/postgres

# JWT Secret for contestant and admin sessions (must be 32+ characters)
JWT_SECRET=debugging-contest-production-jwt-secret-replace-with-random-chars
JWT_EXPIRES_IN=8h

# External Sandboxed Judge Service (Judge0 CE / RapidAPI / Self-Hosted)
# Option A: RapidAPI Judge0
# JUDGE_URL=https://judge0-ce.p.rapidapi.com
# JUDGE_API_KEY=your-rapidapi-key
# JUDGE_HOST=judge0-ce.p.rapidapi.com
# Option B: Self-Hosted Judge0 instance
JUDGE_URL=http://localhost:2358
JUDGE_API_KEY=

# Server & Environment Settings
NODE_ENV=production
PORT=4000
FRONTEND_URL=https://debugging-contest.vercel.app

# Database Connection Pool Ceiling (recommended 2 for serverless functions)
PG_MAX_POOL=2

# Contest ID (optional: leave empty to use the latest active contest)
CONTEST_ID=

# ============================================================
# LOCAL DEVELOPMENT ENVIRONMENT (Docker Compose / Local PostgreSQL)
# ============================================================
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/debugcontest
# JWT_SECRET=local-development-secret-key-32chars
# JUDGE_URL=http://localhost:2358
# JUDGE_API_KEY=
# NODE_ENV=development
# PORT=4000
# FRONTEND_URL=http://localhost:5173
